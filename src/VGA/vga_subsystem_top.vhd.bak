library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity vga_subsystem_top is
  port (
    -- --- Clock e Reset ---
    clk_sys      : in  std_logic;                    -- 100MHz (SoC)
    clk_mem      : in  std_logic;                    -- 150MHz (PSRAM)
    clk_vga      : in  std_logic;                    -- 25.175MHz (VGA)
    rst_n        : in  std_logic;

    -- --- Interfaccia NEORV32 XBUS ---
    xbus_addr_i  : in  std_logic_vector(31 downto 0);
    xbus_data_i  : in  std_logic_vector(31 downto 0);
    xbus_sel_i   : in  std_logic_vector(3 downto 0);
    xbus_we_i    : in  std_logic;
    xbus_stb_i   : in  std_logic;
    xbus_cyc_i   : in  std_logic;
    xbus_data_o  : out std_logic_vector(31 downto 0);
    xbus_ack_o   : out std_logic;

    -- --- Interfaccia Fisica Twin-PSRAM ---
    psram_ce_n   : out std_logic;
    psram_sclk   : out std_logic;
    psram_dq     : inout std_logic_vector(7 downto 0);

    -- --- Uscite DAC 565 Fisico ---
    vga_r        : out std_logic_vector(4 downto 0);
    vga_g        : out std_logic_vector(5 downto 0);
    vga_b        : out std_logic_vector(4 downto 0);
    vga_hsync    : out std_logic;
    vga_vsync    : out std_logic
  );
end entity;

architecture structural of vga_subsystem_top is

  -- Segnali Bus Interno CPU
  signal cpu_req    : std_logic;
  signal cpu_addr   : std_logic_vector(23 downto 0);
  signal cpu_wdata  : std_logic_vector(31 downto 0);
  signal cpu_we     : std_logic;
  signal cpu_gnt    : std_logic;

  -- Segnali Interfaccia Controller <-> VGA (Handshake T80 style)
  signal vga_req    : std_logic;
  signal vga_ack    : std_logic; -- Nuovo ACK
  signal vga_addr   : std_logic_vector(23 downto 0);
  
  -- Segnali Line Buffer
  signal lb_wr_addr : std_logic_vector(9 downto 0);
  signal lb_wr_data : std_logic_vector(15 downto 0);
  signal lb_wr_en   : std_logic;
  signal lb_rd_addr : std_logic_vector(9 downto 0);
  signal lb_rd_data : std_logic_vector(15 downto 0);

begin

  -----------------------------------------------------------------------------
  -- 1. LINE BUFFER (Dual Port RAM) - RAM2
  -----------------------------------------------------------------------------
  inst_line_buffer: entity work.line_buffer
    port map (
      wraddress => lb_wr_addr,
      wrclock   => clk_mem,
      data      => lb_wr_data,
      wren      => lb_wr_en,
      rdaddress => lb_rd_addr,
      rdclock   => clk_vga,
      q         => lb_rd_data
    );

  -----------------------------------------------------------------------------
  -- 2. GATEWAY XBUS (NEORV32 Interface)
  -----------------------------------------------------------------------------
  inst_gateway: entity work.vga_xbus_gateway
    port map (
      clk          => clk_sys,
      rst_n        => rst_n,
      xbus_addr_i  => xbus_addr_i,
      xbus_data_i  => xbus_data_i,
      xbus_we_i    => xbus_we_i,
      xbus_stb_i   => xbus_stb_i,
      xbus_cyc_i   => xbus_cyc_i,
      xbus_ack_o   => xbus_ack_o,
      cpu_req_o    => cpu_req,
      cpu_addr_o   => cpu_addr,
      cpu_data_o   => cpu_wdata,
      cpu_we_o     => cpu_we,
      cpu_gnt_i    => cpu_gnt
    );

  -----------------------------------------------------------------------------
  -- 3. VGA CORE LOGIC (Timing e Richiesta Riga)
  -----------------------------------------------------------------------------
inst_vga_core: entity work.vga_core_logic
  port map (
    pixel_clk       => clk_vga,
    rst_n           => rst_n,
    hsync           => vga_hsync,
    vsync           => vga_vsync,
    r_out           => vga_r,
    g_out           => vga_g,
    b_out           => vga_b,
    h_cnt_o         => lb_rd_addr, -- Indirizzo lettura RAM2
    vga_data_i      => lb_rd_data, -- Dati dalla RAM2
    vga_req_o       => vga_req,    -- LOAD_REQ (scatta a h_cnt = 641)
    vga_ack_i       => vga_ack,    -- LOAD_ACK (torna dal controller)
    vga_line_addr_o => vga_addr    -- Indirizzo riga fisso per tutta la durata del burst
  );

  -----------------------------------------------------------------------------
  -- 4. PSRAM TWIN CONTROLLER
  -----------------------------------------------------------------------------
  inst_psram_ctrl: entity work.psram_twin_controller
    port map (
      clk_cpu         => clk_sys,
      clk_mem         => clk_mem,
      rst_n           => rst_n,
      
      -- Interfaccia VGA (Priorità)
      vga_req_i       => vga_req,
      vga_ack_o       => vga_ack,    -- Collega l'ACK al VGA Core
      vga_addr_i      => vga_addr,
  --    vga_data_o      => open,       -- Non serve qui, va nel Line Buffer
      
      -- Scrittura nel Line Buffer (RAM2)
      lb_wr_en        => lb_wr_en,
      lb_wr_addr      => lb_wr_addr,
      lb_wr_data      => lb_wr_data,
      
      -- Interfaccia CPU
      cpu_req_i       => cpu_req,
      cpu_addr_i      => cpu_addr,
      cpu_data_i      => cpu_wdata,
      cpu_we_i        => cpu_we,
      cpu_gnt_o       => cpu_gnt,
      
      -- Pin Fisici
      psram_dq        => psram_dq,
      psram_sclk      => psram_sclk,
      psram_ce_n      => psram_ce_n
    );
	 
	 

end architecture;